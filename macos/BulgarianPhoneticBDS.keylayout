<?xml version="1.1" encoding="UTF-8"?>
<!DOCTYPE keyboard SYSTEM "file://localhost/System/Library/DTDs/KeyboardLayout.dtd">
<!--
  Bulgarian - Phonetic (BDS 5237:2006)
  Restores the standard phonetic layout (ш on W, в on V, я on [, ж on X)
  that older macOS shipped as "Bulgarian - Phonetic" before it was replaced
  by the traditional phonetic (в on W, ж on V).

  Layers:
    base / shift+caps : Cyrillic (BDS phonetic), US digits & punctuation
    option            : plain US ASCII (access to ` ~ \ | [ ] etc.)
    shift+option      : shifted US ASCII
    command / control : plain US ASCII so app shortcuts (Cmd+W, Ctrl+C) work
-->
<keyboard group="126" id="-28391" name="Bulgarian - Phonetic (BDS)" maxout="1">
  <layouts>
    <layout first="0" last="17" mapSet="mapset1" modifiers="mods1"/>
  </layouts>
  <modifierMap id="mods1" defaultIndex="0">
    <keyMapSelect mapIndex="0">
      <modifier keys=""/>
    </keyMapSelect>
    <keyMapSelect mapIndex="1">
      <modifier keys="anyShift caps?"/>
      <modifier keys="caps"/>
    </keyMapSelect>
    <keyMapSelect mapIndex="2">
      <modifier keys="anyOption caps?"/>
      <modifier keys="anyShift? caps? anyOption? anyControl? command"/>
      <modifier keys="anyShift? caps? anyOption? anyControl"/>
    </keyMapSelect>
    <keyMapSelect mapIndex="3">
      <modifier keys="anyShift anyOption caps?"/>
    </keyMapSelect>
  </modifierMap>
  <keyMapSet id="mapset1">

    <!-- index 0: Cyrillic, BDS phonetic -->
